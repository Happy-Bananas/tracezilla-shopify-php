# Your Shopify store and the app you created for this integration; see
# Shopify Prerequisites in the manual. The client ID and secret are on the
# app's settings page.
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# The access scopes the app was released with, separated by commas. The
# commands need: read_products (catalog), read_locations (locations),
# read_inventory and write_inventory (inventory sync), read_orders (orders).
SHOPIFY_SCOPE=read_products
SHOPIFY_API_VERSION=2025-10

TRACEZILLA_BASE_URL=https://app.tracezilla.com
# The team slug is part of every API URL: /api/v1/{team-slug}/...
# Find it in the browser URL when the team is open in tracezilla.
TRACEZILLA_TEAM_SLUG=

# OAuth client for the Resource Owner Password Credentials grant. How to create
# it: https://tech.tracezilla.com/docs/rest-api-v1/making-requests/authentication.html#bearer-token-and-resource-owner-password-credentials
# Then run bin/bifrost-connect tracezilla:login once; it stores the tokens in
# the runtime directory (TRACEZILLA_RUNTIME_DIR below), and they are renewed
# automatically.
TRACEZILLA_CLIENT_ID=
TRACEZILLA_CLIENT_SECRET=

# Directory for the run lock, the retry queue and the tracezilla tokens.
# Relative paths start at the project folder. Keep it between runs and out of
# Git.

TRACEZILLA_RUNTIME_DIR=var

HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
