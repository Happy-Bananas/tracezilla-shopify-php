SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPE=read_products
SHOPIFY_API_VERSION=2025-10

TRACEZILLA_BASE_URL=https://app.tracezilla.com
TRACEZILLA_TEAM_SLUG=
# The Resource Owner Password Credentials from tracezilla: the OAuth client and
# the API user (…@tracezilla.api) created with it, never a person's login. How
# to create them: https://tech.tracezilla.com/docs/rest-api-v1/making-requests/authentication.html#bearer-token-and-resource-owner-password-credentials
# The integration logs in by itself, stores the tokens in the runtime directory
# and renews them automatically.
TRACEZILLA_CLIENT_ID=
TRACEZILLA_CLIENT_SECRET=
TRACEZILLA_USERNAME=
TRACEZILLA_PASSWORD=
TRACEZILLA_RUNTIME_DIR=var

HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
