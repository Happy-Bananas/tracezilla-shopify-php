SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPE=read_products
SHOPIFY_API_VERSION=2025-10

TRACEZILLA_BASE_URL=https://app.tracezilla.com
TRACEZILLA_TEAM_SLUG=
# OAuth client for the Resource Owner Password Credentials grant. How to create
# it: https://tech.tracezilla.com/docs/rest-api-v1/making-requests/authentication.html#bearer-token-and-resource-owner-password-credentials
# Then run bin/bifrost-connect tracezilla:login once; it stores tokens in the
# runtime directory and they are renewed automatically.
TRACEZILLA_CLIENT_ID=
TRACEZILLA_CLIENT_SECRET=
TRACEZILLA_RUNTIME_DIR=var
# Exact name of your company's own partner in tracezilla. The seed
# (tracezilla:seed) adds its warehouse location to this partner.
TRACEZILLA_OWN_COMPANY=
# The seed writes test data only into this team. In a development project,
# set it to the TRACEZILLA_TEAM_SLUG above. Never set it for a customer's
# production team.
TRACEZILLA_SEED_ALLOWED_TEAM=

HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
