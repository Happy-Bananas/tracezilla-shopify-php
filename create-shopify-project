#!/bin/sh
# Kept so existing instructions keep working. The shared create-project script
# does the work for every platform:
#
#   curl -fsSL https://happy-bananas.github.io/tracezilla-integrations-docs/create-project | sh -s -- shopify <project>

set -eu

project=${1:-my-bifrost-connect-project}
create_project=${TRACEZILLA_CREATE_PROJECT_URL:-https://happy-bananas.github.io/tracezilla-integrations-docs/create-project}

if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required to create the project." >&2
    exit 2
fi

script=$(curl -fsSL "$create_project")
printf '%s\n' "$script" | sh -s -- shopify "$project"
