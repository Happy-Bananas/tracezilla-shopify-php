#!/bin/sh

set -eu

echo ""
echo "============================================================"
echo "  BifrostConnect is starting"
echo "  Please hang on; the first startup might take a while."
echo "============================================================"
echo ""

echo "Checking PHP dependencies..."
composer install --no-interaction --no-progress

if [ ! -f /app/.env ]; then
    echo ""
    echo "NOTICE: No .env file was found."
    echo "Create it with: cp .env.example .env"
fi

touch /tmp/tracezilla-integration-ready

echo ""
echo "============================================================"
echo "  BIFROSTCONNECT IS READY"
echo ""
echo "  Open another terminal and run:"
echo "  docker compose exec integration php bin/bifrost-connect help"
echo "============================================================"
echo ""

exec sleep infinity
