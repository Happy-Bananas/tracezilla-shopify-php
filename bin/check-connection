#!/usr/bin/env php
<?php

declare(strict_types=1);

// Checks the Shopify and tracezilla connections and prints the result.
// Exit code 0 means both connections work.

use Dotenv\Dotenv;
use Tracezilla\Shopify\Connection\ConnectionChecker;
use Tracezilla\Shopify\Connection\LiveShopifyConnection;
use Tracezilla\Shopify\Connection\LiveTracezillaConnection;

$project = dirname(__DIR__);
require $project.'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable($project)->safeLoad();

$checker = new ConnectionChecker(
    new LiveShopifyConnection(),
    new LiveTracezillaConnection($project),
    (string) getenv('TRACEZILLA_TEAM_SLUG'),
);
$result = $checker->check();

$options = getopt('', ['json']);
if (array_key_exists('json', $options)) {
    printJson($result);
} else {
    printText($result);
}

if ($result['status'] === 'ok') {
    exit(0);
}
exit(1);

function printJson(array $result): void
{
    echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
}

function printText(array $result): void
{
    if ($result['status'] === 'ok') {
        echo "Connection check passed.\n";
    } else {
        echo "Connection check failed.\n";
    }

    $shopify = $result['shopify'];
    if ($shopify['connected']) {
        $domain = $shopify['domain'] ?? 'unknown domain';
        echo "Shopify:    connected to {$shopify['shop_name']} ({$domain})\n";
    } else {
        echo "Shopify:    FAILED - {$shopify['error']}\n";
    }

    $tracezilla = $result['tracezilla'];
    if ($tracezilla['connected']) {
        echo "tracezilla: connected to team {$tracezilla['team']}\n";
    } else {
        echo "tracezilla: FAILED - {$tracezilla['error']}\n";
    }
}
