#!/usr/bin/env php
<?php

declare(strict_types=1);

use Bifrost\Core\Lock\RunLock;
use Bifrost\Core\Tracezilla\Client as TracezillaClient;
use Bifrost\Core\Tracezilla\TokenProvider;
use Bifrost\Core\Tracezilla\TracezillaConfiguration;
use Dotenv\Dotenv;
use Tracezilla\Shopify\Configuration;
use Tracezilla\Shopify\Output\CommandExecution;
use Tracezilla\Shopify\Output\ShopifyProductDecisionReportRenderer;
use Tracezilla\Shopify\Shopify\Mappers\ShopifyVariantMapper;
use Tracezilla\Shopify\Shopify\ShopifyCatalogService;
use Tracezilla\Shopify\Shopify\ShopifyClient;
use Tracezilla\Shopify\Tracezilla\Mappers\TracezillaSkuMapper;
use Tracezilla\Shopify\Tracezilla\TracezillaCatalogService;
use Tracezilla\Shopify\Workflows\ReportTracezillaSkusNeedingShopifyDecision;

require dirname(__DIR__).'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable(dirname(__DIR__))->safeLoad();
// Before reading anything: no other integration command may run meanwhile.
RunLock::takeOrExit(dirname(__DIR__), 'catalog:report-shopify-decisions');

try {
    $options = getopt('', ['limit::', 'json']);
    $limit = isset($options['limit']) ? filter_var($options['limit'], FILTER_VALIDATE_INT) : 10;
    if ($limit === false || $limit < 1) {
        throw new InvalidArgumentException('--limit must be a positive integer.');
    }

    $configuration = Configuration::fromEnvironment();
    $tracezillaConfiguration = TracezillaConfiguration::fromEnvironment(dirname(__DIR__));
    $tracezillaClient = new TracezillaClient($tracezillaConfiguration, TokenProvider::fromConfiguration($tracezillaConfiguration));
    $result = (new ReportTracezillaSkusNeedingShopifyDecision(
        new ShopifyCatalogService(new ShopifyClient($configuration), new ShopifyVariantMapper()),
        new TracezillaCatalogService($tracezillaClient, new TracezillaSkuMapper()),
    ))->run($limit);

    $displayedCommand = 'php bin/report-tracezilla-skus-needing-shopify-decision';
    if (isset($options['limit'])) {
        $displayedCommand .= " --limit={$limit}";
    }
    if (array_key_exists('json', $options)) {
        $displayedCommand .= ' --json';
    }
    $execution = new CommandExecution($displayedCommand, 'read_only');

    echo array_key_exists('json', $options)
        ? json_encode($execution->withResult($result->toArray()), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES).PHP_EOL
        : $execution->header().(new ShopifyProductDecisionReportRenderer())->render($result);
    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Shopify product-decision report failed: '.$exception->getMessage().PHP_EOL);
    exit(1);
}
