#!/usr/bin/env php
<?php

declare(strict_types=1);

use Bifrost\Core\Lock\RunLock;
use Bifrost\Core\RuntimeDirectory;
use Dotenv\Dotenv;
use Tracezilla\Shopify\Retry\FileRetryRepository;
use Tracezilla\Shopify\Retry\RetryManagement;

$project = dirname(__DIR__);
require $project.'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable($project)->safeLoad();
// Before reading anything: no other integration command may run meanwhile.
RunLock::takeOrExit($project, 'failures:retry');

try {
    $arguments = getopt('', ['task:']);
    $taskId = trim((string) ($arguments['task'] ?? ''));
    if ($taskId === '') {
        throw new InvalidArgumentException('--task is required.');
    }
    $task = (new RetryManagement(
        new FileRetryRepository(RuntimeDirectory::resolve($project)),
    ))->retry($taskId, new DateTimeImmutable('now'));
    echo json_encode($task->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL;
    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Could not retry failure: '.$exception->getMessage().PHP_EOL);
    exit(1);
}

