#!/usr/bin/env php
<?php

declare(strict_types=1);

// The single entry point: runs one of the commands in bin/. Each command that
// must not overlap with another takes the integration's run lock itself
// (Bifrost\Core\Lock\RunLock), so it is protected however it is started.
// Each command loads .env itself, so this file needs neither .env nor the
// PHP packages.

$commands = [
    'connection:check' => 'check-connection',
    'tracezilla:seed' => 'seed-tracezilla',
    'catalog:compare' => 'compare-catalogs',
    'catalog:report-shopify-decisions' => 'report-tracezilla-skus-needing-shopify-decision',
    'catalog:create-tracezilla-skus' => 'create-tracezilla-skus',
    'shopify:locations' => 'list-shopify-locations',
    'inventory:sync' => 'synchronize-inventory',
    'orders:report-collected' => 'report-collected-orders',
    'orders:import-individual' => 'import-individual-orders',
    'deployment:check' => 'deployment-check',
    'failures:list' => 'failures-list',
    'failures:retry' => 'failures-retry',
    'failures:dismiss' => 'failures-dismiss',
    'scenario:create' => 'scenario-create',
    'scenario:run' => 'scenario-run',
];
// A project can leave out optional commands, such as the seed. Only commands
// whose script is in bin/ are offered.
$commands = installedCommands($commands);

$command = $argv[1] ?? 'help';

if (in_array($command, ['help', '--help', '-h', 'list'], true)) {
    echo "BifrostConnect\n\n";
    echo "Usage:\n";
    echo "  php bin/bifrost-connect <command> [options]\n\n";
    echo "Available commands:\n";
    foreach (array_keys($commands) as $name) {
        echo "  {$name}\n";
    }
    echo "\nRun a command with its options, for example:\n";
    echo "  php bin/bifrost-connect catalog:compare --limit=10\n";
    exit(0);
}

if (! isset($commands[$command])) {
    fwrite(STDERR, "Unknown command: {$command}\n");
    fwrite(STDERR, "Run 'php bin/bifrost-connect help' to list commands.\n");
    exit(2);
}

$script = __DIR__.DIRECTORY_SEPARATOR.$commands[$command];
$arguments = array_slice($argv, 2);
$parts = array_merge([PHP_BINARY, $script], $arguments);
$shellCommand = implode(' ', array_map('escapeshellarg', $parts));

passthru($shellCommand, $exitCode);
exit($exitCode);

/**
 * The commands whose script exists in bin/.
 *
 * @param array<string, string> $commands Command name => script name
 * @return array<string, string>
 */
function installedCommands(array $commands): array
{
    $installed = [];
    foreach ($commands as $name => $script) {
        if (is_file(__DIR__.DIRECTORY_SEPARATOR.$script)) {
            $installed[$name] = $script;
        }
    }

    return $installed;
}
