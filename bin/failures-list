#!/usr/bin/env php
<?php

declare(strict_types=1);

use Bifrost\Core\RuntimeDirectory;
use Dotenv\Dotenv;
use Tracezilla\Shopify\Retry\FileRetryRepository;
use Tracezilla\Shopify\Retry\RetryManagement;

$project = dirname(__DIR__);
require $project.'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable($project)->safeLoad();

try {
    $result = (new RetryManagement(
        new FileRetryRepository(RuntimeDirectory::resolve($project)),
    ))->list();
    echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL;
    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Could not list failures: '.$exception->getMessage().PHP_EOL);
    exit(1);
}

